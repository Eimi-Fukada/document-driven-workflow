{
  "name": "document-driven-workflow",
  "version": "0.1.0",
  "private": true,
  "description": "Document-driven product delivery workflow for Codex and Claude Code.",
  "scripts": {
    "build": "node scripts/build/build-skills.mjs",
    "check": "node scripts/quality/ensure-dist.mjs && powershell -ExecutionPolicy Bypass -File scripts/quality/check.ps1 && node scripts/quality/check-encoding.mjs",
    "workflow:agent-plan": "node scripts/workflow/automation/agent-plan.mjs",
    "workflow:adopt": "node scripts/workflow/automation/adopt.mjs",
    "workflow:approval-review": "node scripts/workflow/automation/approval-review.mjs",
    "workflow:approve": "node scripts/workflow/automation/approve.mjs",
    "workflow:completion-check": "node scripts/workflow/automation/completion-check.mjs",
    "workflow:context-pack": "node scripts/workflow/automation/context-pack.mjs",
    "workflow:continue": "node scripts/workflow/automation/continue.mjs",
    "workflow:doctor": "node scripts/workflow/automation/doctor.mjs",
    "workflow:finish-feature": "node scripts/workflow/automation/finish-feature.mjs",
    "workflow:handoff-pack": "node scripts/workflow/automation/handoff-pack.mjs",
    "workflow:init-product": "node scripts/workflow/product/init-product.mjs",
    "workflow:process": "node scripts/workflow/automation/process.mjs",
    "workflow:route": "node scripts/workflow/automation/route.mjs",
    "workflow:status": "node scripts/workflow/automation/status.mjs",
    "workflow:verify": "node scripts/workflow/automation/verify.mjs",
    "epic:features": "node scripts/workflow/epic/create-features.mjs",
    "epic:hydrate": "node scripts/workflow/epic/hydrate-epic.mjs",
    "epic:new": "node scripts/workflow/epic/new-epic.mjs",
    "feature:hydrate": "node scripts/workflow/feature/hydrate-feature.mjs",
    "feature:new": "node scripts/workflow/feature/new-feature.mjs",
    "gate:epic": "node scripts/workflow/epic/gate-epic.mjs",
    "gate:dev": "node scripts/workflow/feature/gate-feature.mjs",
    "setup": "node scripts/install/setup.mjs",
    "setup:all": "node scripts/install/setup.mjs --host all",
    "setup:claude": "node scripts/install/setup.mjs --host claude",
    "setup:codex": "node scripts/install/setup.mjs --host codex",
    "test:gates": "powershell -ExecutionPolicy Bypass -File scripts/workflow/test/test-gates.ps1",
    "test": "npm run build && npm run check && npm run test:gates"
  }
}
